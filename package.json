{
  "name": "mockimagemaker",
  "productName": "MockImageMaker",
  "version": "1.0.0",
  "private": true,
  "description": "モックイメージメーカー — 業務アプリの画面設計（モック）を描いてベンダーと共有するデスクトップアプリ",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "pack": "node node_modules/electron/install.js && electron-builder --dir",
    "dist": "node node_modules/electron/install.js && electron-builder --win --publish never"
  },
  "author": "kuwagata-137",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "electron-window-state": "^5.0.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^29.1.1",
    "puppeteer": "^25.0.4"
  },
  "build": {
    "appId": "com.kuwagata.mockimagemaker",
    "productName": "MockImageMaker",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist"
    },
    "files": [
      "mock_v1.00.html",
      "main.js",
      "preload.js",
      "storage.js",
      "export.js",
      "automation-protocol.js",
      "automation.js",
      "automation-main.js",
      "automation-render.js",
      "automation-client.js",
      "mcp-server.js",
      "mcp-tools.js",
      "mcp-schemas.js",
      "mcp-guide.js",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "モックイメージメーカー"
    }
  }
}
