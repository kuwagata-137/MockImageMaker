{
  "autoCompactWindow": 500000,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-main-push.js\"",
            "statusMessage": "main直push ガード"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/compact-plan.js\" pre",
            "statusMessage": "圧縮の前にプランを控える"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/compact-plan.js\" post",
            "statusMessage": "圧縮の後にプランを確かめる"
          }
        ]
      }
    ]
  }
}
